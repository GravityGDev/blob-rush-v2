{
  "name": "PlayerAccount",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "player",
        "vip",
        "moderator",
        "admin"
      ],
      "default": "player",
      "description": "Game role of this player"
    },
    "discord_id": {
      "type": "string",
      "description": "Linked Discord user id"
    },
    "discord_username": {
      "type": "string",
      "description": "Linked Discord username"
    },
    "discord_avatar": {
      "type": "string",
      "description": "Linked Discord avatar URL"
    },
    "data": {
      "type": "object",
      "description": "Full saved game profile (stats, coins, skins, cosmetics, settings)",
      "additionalProperties": true
    }
  },
  "required": []
}